def rec rateDebitSelectedExactly : (buckets : RateBuckets) -> (key : Count) ->
    Equal Count (rateBucketCredit key (debitRateBucket key buckets)) (predecessor (rateBucketCredit key buckets)) :=
  fun (buckets : RateBuckets) (key : Count) =>
