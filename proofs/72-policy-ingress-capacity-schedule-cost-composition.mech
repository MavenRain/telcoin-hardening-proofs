      (capacityScheduledIngressExecutionCost weight slots payloadLimit capacity policyIngressCapacityExecutionDone config state scanCost handoffCost turnCost resizeCost boundaryCost eventCost policyCost handshakeCost) zero :=
  fun (weight : PolicyIngressEvent -> Count) (slots : Count) (payloadLimit : Count) (capacity : Count) (config : PolicyWorkConfig) (state : PolicyIngressResumeState)
      (scanCost : Count) (handoffCost : Count) (turnCost : Count) (resizeCost : Count) (boundaryCost : Count) (eventCost : Count) (policyCost : Count) (handshakeCost : Count) => same
