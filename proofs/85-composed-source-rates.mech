def rateBeyondAllocationAttemptStable : (enabled : Flag) -> (aggregate : Count) -> (buckets : RateBuckets) -> (offset : Count) ->
    Equal ComposedRateState (composedRateState
      (rateAggregateSpend enabled aggregate (rateBucketCredit (add (rateBucketWidth buckets) offset) buckets))
      (rateSourceSpend enabled (add (rateBucketWidth buckets) offset) buckets)) (composedRateState aggregate buckets) :=
