            (splitPrivilege loadPenaltyPrivilege limits role swarm
              (splitPrivilegePolicy (authoritativeUnionPolicy generation validator hub observer) self) authenticated identity) with
      | privilegeAllocations admission retention load => same

def loadPenaltyChangeKeepsAdmission : (authority : AuthoritativeUnionPolicy) -> (allocations : PrivilegeAllocations) ->
    (incoming : PrivilegeRecipients) -> (limits : PrivilegeLimits) -> (role : NodePolicyRole) ->
    (swarm : NodePolicySwarm) -> (authenticated : Flag) -> (identity : Count) ->
    Equal Flag
      (splitPrivilege admissionPrivilege limits role swarm
        (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming) (splitPrivilegePolicy authority allocations))
        authenticated identity)
      (splitPrivilege admissionPrivilege limits role swarm (splitPrivilegePolicy authority allocations) authenticated identity) :=
  fun (authority : AuthoritativeUnionPolicy) (allocations : PrivilegeAllocations) (incoming : PrivilegeRecipients)
      (limits : PrivilegeLimits) (role : NodePolicyRole) (swarm : NodePolicySwarm) (authenticated : Flag) (identity : Count) =>
    case authority as current in AuthoritativeUnionPolicy return
        Equal Flag
          (splitPrivilege admissionPrivilege limits role swarm
            (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming) (splitPrivilegePolicy current allocations))
            authenticated identity)
          (splitPrivilege admissionPrivilege limits role swarm (splitPrivilegePolicy current allocations) authenticated identity) with
    | authoritativeUnionPolicy generation validator hub observer =>
      case allocations as self in PrivilegeAllocations return
          Equal Flag
            (splitPrivilege admissionPrivilege limits role swarm
              (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming)
                (splitPrivilegePolicy (authoritativeUnionPolicy generation validator hub observer) self)) authenticated identity)
            (splitPrivilege admissionPrivilege limits role swarm
              (splitPrivilegePolicy (authoritativeUnionPolicy generation validator hub observer) self) authenticated identity) with
      | privilegeAllocations admission retention load => same

def loadPenaltyChangeKeepsRetention : (authority : AuthoritativeUnionPolicy) -> (allocations : PrivilegeAllocations) ->
    (incoming : PrivilegeRecipients) -> (limits : PrivilegeLimits) -> (role : NodePolicyRole) ->
    (swarm : NodePolicySwarm) -> (authenticated : Flag) -> (identity : Count) ->
    Equal Flag
      (splitPrivilege retentionPrivilege limits role swarm
        (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming) (splitPrivilegePolicy authority allocations))
        authenticated identity)
      (splitPrivilege retentionPrivilege limits role swarm (splitPrivilegePolicy authority allocations) authenticated identity) :=
  fun (authority : AuthoritativeUnionPolicy) (allocations : PrivilegeAllocations) (incoming : PrivilegeRecipients)
      (limits : PrivilegeLimits) (role : NodePolicyRole) (swarm : NodePolicySwarm) (authenticated : Flag) (identity : Count) =>
    case authority as current in AuthoritativeUnionPolicy return
        Equal Flag
          (splitPrivilege retentionPrivilege limits role swarm
            (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming) (splitPrivilegePolicy current allocations))
            authenticated identity)
          (splitPrivilege retentionPrivilege limits role swarm (splitPrivilegePolicy current allocations) authenticated identity) with
    | authoritativeUnionPolicy generation validator hub observer =>
      case allocations as self in PrivilegeAllocations return
          Equal Flag
            (splitPrivilege retentionPrivilege limits role swarm
              (applySplitPrivilegeChange (splitAllocationChange on loadPenaltyPrivilege incoming)
                (splitPrivilegePolicy (authoritativeUnionPolicy generation validator hub observer) self)) authenticated identity)
            (splitPrivilege retentionPrivilege limits role swarm
              (splitPrivilegePolicy (authoritativeUnionPolicy generation validator hub observer) self) authenticated identity) with
      | privilegeAllocations admission retention load => same

def unauthorizedPrivilegeChangeNoOp : (policy : SplitPrivilegePolicy) -> (kind : PrivilegeKind) ->
    (incoming : PrivilegeRecipients) ->
    Equal SplitPrivilegePolicy (applySplitPrivilegeChange (splitAllocationChange off kind incoming) policy) policy :=
  fun (policy : SplitPrivilegePolicy) (kind : PrivilegeKind) (incoming : PrivilegeRecipients) =>
    case policy as self in SplitPrivilegePolicy return
        Equal SplitPrivilegePolicy (applySplitPrivilegeChange (splitAllocationChange off kind incoming) self) self with
    | splitPrivilegePolicy authority allocations => same

def authorityChangeKeepsPrivilegeAllocations : (change : AuthoritativeUnionChange) -> (policy : SplitPrivilegePolicy) ->
    Equal PrivilegeAllocations (splitPrivilegeAllocations (applySplitPrivilegeChange (splitAuthorityChange change) policy))
      (splitPrivilegeAllocations policy) :=
  fun (change : AuthoritativeUnionChange) (policy : SplitPrivilegePolicy) =>
    case policy as self in SplitPrivilegePolicy return
        Equal PrivilegeAllocations (splitPrivilegeAllocations (applySplitPrivilegeChange (splitAuthorityChange change) self))
          (splitPrivilegeAllocations self) with
    | splitPrivilegePolicy authority allocations => same

def privilegeChangeAdvancesRevision : (authority : AuthoritativeUnionPolicy) -> (allocations : PrivilegeAllocations) ->
    (kind : PrivilegeKind) -> (incoming : PrivilegeRecipients) ->
    Equal Count (authoritativeUnionGeneration (splitPrivilegeAuthority
      (applySplitPrivilegeChange (splitAllocationChange on kind incoming) (splitPrivilegePolicy authority allocations))))
      (next (authoritativeUnionGeneration authority)) :=
  fun (authority : AuthoritativeUnionPolicy) (allocations : PrivilegeAllocations) (kind : PrivilegeKind)
      (incoming : PrivilegeRecipients) =>
    case authority as self in AuthoritativeUnionPolicy return
        Equal Count (authoritativeUnionGeneration (splitPrivilegeAuthority
          (applySplitPrivilegeChange (splitAllocationChange on kind incoming) (splitPrivilegePolicy self allocations))))
          (next (authoritativeUnionGeneration self)) with
    | authoritativeUnionPolicy generation validator hub observer => same

def authorizedPrivilegeAllocationSelected : (authority : AuthoritativeUnionPolicy) -> (allocations : PrivilegeAllocations) ->
    (kind : PrivilegeKind) -> (incoming : PrivilegeRecipients) -> (limits : PrivilegeLimits) ->
    Equal PrivilegeRecipients (allocatedPrivilegeRecipients kind limits
      (applySplitPrivilegeChange (splitAllocationChange on kind incoming) (splitPrivilegePolicy authority allocations)))
      (boundedPrivilegeRecipients (privilegeLimitAt kind limits) incoming) :=
  fun (authority : AuthoritativeUnionPolicy) (allocations : PrivilegeAllocations) (kind : PrivilegeKind)
      (incoming : PrivilegeRecipients) (limits : PrivilegeLimits) =>
    congruent PrivilegeRecipients PrivilegeRecipients (boundedPrivilegeRecipients (privilegeLimitAt kind limits))
      (privilegeAllocationAt kind (replacePrivilegeAllocation kind incoming allocations)) incoming
      (replacedPrivilegeSelected kind incoming allocations)

def boundedPrivilegeHeadMember : (identity : Count) -> (capacity : Count) -> (rest : PrivilegeRecipients) ->
    Equal Flag (privilegeRecipientMember identity
      (boundedPrivilegeRecipients (next capacity) (privilegeRecipient identity rest))) on :=
  fun (identity : Count) (capacity : Count) (rest : PrivilegeRecipients) =>
    congruent Flag Flag
      (fun (matched : Flag) => either matched (privilegeRecipientMember identity (boundedPrivilegeRecipients capacity rest)))
      (sameCount identity identity) on (sameCountReflexive identity)

def privilegeMemberSkipsDifferentHead : (identity : Count) -> (other : Count) -> (rest : PrivilegeRecipients) ->
    Equal Flag (sameCount identity other) off ->
    Equal Flag (privilegeRecipientMember identity (privilegeRecipient other rest)) (privilegeRecipientMember identity rest) :=
  fun (identity : Count) (other : Count) (rest : PrivilegeRecipients)
      (different : Equal Flag (sameCount identity other) off) =>
    congruent Flag Flag (fun (matched : Flag) => either matched (privilegeRecipientMember identity rest))
      (sameCount identity other) off different

def zeroPrivilegeAllocationCannotGrant : (identity : Count) -> (recipients : PrivilegeRecipients) ->
    Equal Flag (privilegeRecipientMember identity (boundedPrivilegeRecipients zero recipients)) off :=
  fun (identity : Count) (recipients : PrivilegeRecipients) => same

def loadPrivilegeSuppressesOnlyLoadBan : (policy : SplitPrivilegePolicy) -> (limits : PrivilegeLimits) ->
    (role : NodePolicyRole) -> (swarm : NodePolicySwarm) -> (authenticated : Flag) -> (identity : Count) ->
    Equal Flag (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) on ->
    Equal Flag (splitPrivilegeBan loadPressure limits role swarm policy authenticated identity) off :=
  fun (policy : SplitPrivilegePolicy) (limits : PrivilegeLimits) (role : NodePolicyRole) (swarm : NodePolicySwarm)
      (authenticated : Flag) (identity : Count)
      (exempt : Equal Flag (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) on) =>
    congruent Flag Flag (ban loadPressure)
      (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) on exempt

def noLoadPrivilegePreservesLoadBan : (policy : SplitPrivilegePolicy) -> (limits : PrivilegeLimits) ->
    (role : NodePolicyRole) -> (swarm : NodePolicySwarm) -> (authenticated : Flag) -> (identity : Count) ->
    Equal Flag (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) off ->
    Equal Flag (splitPrivilegeBan loadPressure limits role swarm policy authenticated identity) on :=
  fun (policy : SplitPrivilegePolicy) (limits : PrivilegeLimits) (role : NodePolicyRole) (swarm : NodePolicySwarm)
      (authenticated : Flag) (identity : Count)
      (ordinary : Equal Flag (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) off) =>
    congruent Flag Flag (ban loadPressure)
      (splitPrivilege loadPenaltyPrivilege limits role swarm policy authenticated identity) off ordinary

def grantedPrivilegeServiceExact : (policy : SplitPrivilegePolicy) -> (kind : PrivilegeKind) ->
    (allocations : PrivilegeLimits) -> (role : NodePolicyRole) -> (swarm : NodePolicySwarm) ->
    (authenticated : Flag) -> (identity : Count) -> (axis : PrivilegeResourceAxis) ->
    (limits : PrivilegeResources) -> (demand : PrivilegeResources) ->
    Equal Flag (splitPrivilege kind allocations role swarm policy authenticated identity) on ->
    Equal Count (splitPrivilegeService kind allocations role swarm policy authenticated identity axis limits demand)
      (boundedWork (privilegeResourceAt axis limits) (privilegeResourceAt axis demand)) :=
  fun (policy : SplitPrivilegePolicy) (kind : PrivilegeKind) (allocations : PrivilegeLimits)
      (role : NodePolicyRole) (swarm : NodePolicySwarm) (authenticated : Flag) (identity : Count)
      (axis : PrivilegeResourceAxis) (limits : PrivilegeResources) (demand : PrivilegeResources)
      (granted : Equal Flag (splitPrivilege kind allocations role swarm policy authenticated identity) on) =>
    congruent Flag Count (splitPrivilegeWork axis limits demand)
      (splitPrivilege kind allocations role swarm policy authenticated identity) on granted

def deniedPrivilegeServiceZero : (policy : SplitPrivilegePolicy) -> (kind : PrivilegeKind) ->
    (allocations : PrivilegeLimits) -> (role : NodePolicyRole) -> (swarm : NodePolicySwarm) ->
    (authenticated : Flag) -> (identity : Count) -> (axis : PrivilegeResourceAxis) ->
    (limits : PrivilegeResources) -> (demand : PrivilegeResources) ->
    Equal Flag (splitPrivilege kind allocations role swarm policy authenticated identity) off ->
    Equal Count (splitPrivilegeService kind allocations role swarm policy authenticated identity axis limits demand) zero :=
  fun (policy : SplitPrivilegePolicy) (kind : PrivilegeKind) (allocations : PrivilegeLimits)
      (role : NodePolicyRole) (swarm : NodePolicySwarm) (authenticated : Flag) (identity : Count)
      (axis : PrivilegeResourceAxis) (limits : PrivilegeResources) (demand : PrivilegeResources)
      (denied : Equal Flag (splitPrivilege kind allocations role swarm policy authenticated identity) off) =>
    congruent Flag Count (splitPrivilegeWork axis limits demand)
      (splitPrivilege kind allocations role swarm policy authenticated identity) off denied

def privilegeCpuCoordinate : (cpu : Count) -> (memory : Count) -> (bulk : Count) ->
    Equal Count (privilegeResourceAt privilegeCpu (privilegeResources cpu memory bulk)) cpu :=
  fun (cpu : Count) (memory : Count) (bulk : Count) => same

def privilegeMemoryCoordinate : (cpu : Count) -> (memory : Count) -> (bulk : Count) ->
    Equal Count (privilegeResourceAt privilegeMemory (privilegeResources cpu memory bulk)) memory :=
  fun (cpu : Count) (memory : Count) (bulk : Count) => same

def privilegeBulkCoordinate : (cpu : Count) -> (memory : Count) -> (bulk : Count) ->
    Equal Count (privilegeResourceAt privilegeBulk (privilegeResources cpu memory bulk)) bulk :=
  fun (cpu : Count) (memory : Count) (bulk : Count) => same

def splitPrivilegeRunHead : (change : SplitPrivilegeChange) -> (rest : SplitPrivilegeChanges) ->
    (policy : SplitPrivilegePolicy) ->
    Equal SplitPrivilegePolicy (runSplitPrivilegeChanges (splitPrivilegeChange change rest) policy)
      (runSplitPrivilegeChanges rest (applySplitPrivilegeChange change policy)) :=
  fun (change : SplitPrivilegeChange) (rest : SplitPrivilegeChanges) (policy : SplitPrivilegePolicy) => same

def splitPrivilegeRunEmpty : (policy : SplitPrivilegePolicy) ->
    Equal SplitPrivilegePolicy (runSplitPrivilegeChanges noSplitPrivilegeChanges policy) policy :=
  fun (policy : SplitPrivilegePolicy) => same

def splitAuthorityUpdateExact : (change : AuthoritativeUnionChange) -> (policy : SplitPrivilegePolicy) ->
    Equal AuthoritativeUnionPolicy (splitPrivilegeAuthority (applySplitPrivilegeChange (splitAuthorityChange change) policy))
      (applyAuthoritativeUnionChange change (splitPrivilegeAuthority policy)) :=
  fun (change : AuthoritativeUnionChange) (policy : SplitPrivilegePolicy) =>
    case policy as self in SplitPrivilegePolicy return
        Equal AuthoritativeUnionPolicy (splitPrivilegeAuthority (applySplitPrivilegeChange (splitAuthorityChange change) self))
          (applyAuthoritativeUnionChange change (splitPrivilegeAuthority self)) with
    | splitPrivilegePolicy authority allocations => same

def splitPrivilegeAfterRemoval : (changes : SplitPrivilegeChanges) -> (policy : SplitPrivilegePolicy) ->
    (kind : PrivilegeKind) -> (limits : PrivilegeLimits) -> (role : NodePolicyRole) -> (swarm : NodePolicySwarm) ->
    (authenticated : Flag) -> (identity : Count) ->
    Equal Flag (committeeUnionMember identity (authoritativeUnionAt role swarm
      (splitPrivilegeAuthority (runSplitPrivilegeChanges changes policy)))) off ->
    Equal Flag (splitPrivilege kind limits role swarm (runSplitPrivilegeChanges changes policy) authenticated identity) off :=
  fun (changes : SplitPrivilegeChanges) (policy : SplitPrivilegePolicy) (kind : PrivilegeKind) (limits : PrivilegeLimits)
      (role : NodePolicyRole) (swarm : NodePolicySwarm) (authenticated : Flag) (identity : Count)
      (removed : Equal Flag (committeeUnionMember identity (authoritativeUnionAt role swarm
        (splitPrivilegeAuthority (runSplitPrivilegeChanges changes policy)))) off) =>
    splitPrivilegeNeedsCurrentMembership (runSplitPrivilegeChanges changes policy) kind limits role swarm authenticated identity removed

def admissionPrivilegeLimitSelected : (admission : Count) -> (retention : Count) -> (load : Count) ->
    Equal Count (privilegeLimitAt admissionPrivilege (privilegeLimits admission retention load)) admission :=
  fun (admission : Count) (retention : Count) (load : Count) => same

def retentionPrivilegeLimitSelected : (admission : Count) -> (retention : Count) -> (load : Count) ->
    Equal Count (privilegeLimitAt retentionPrivilege (privilegeLimits admission retention load)) retention :=
  fun (admission : Count) (retention : Count) (load : Count) => same

def loadPenaltyPrivilegeLimitSelected : (admission : Count) -> (retention : Count) -> (load : Count) ->
    Equal Count (privilegeLimitAt loadPenaltyPrivilege (privilegeLimits admission retention load)) load :=
  fun (admission : Count) (retention : Count) (load : Count) => same
