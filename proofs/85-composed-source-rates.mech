        (rateAggregateSpend allowed aggregate (rateBucketCredit (add (rateBucketWidth buckets) offset) buckets))
        (rateSourceSpend allowed (add (rateBucketWidth buckets) offset) buckets)) (composedRateState aggregate buckets) with
    | off => same
    | on => equalTransitivity ComposedRateState
        (composedRateState (rateAggregateSpend on aggregate (rateBucketCredit (add (rateBucketWidth buckets) offset) buckets))
          (debitRateBucket (add (rateBucketWidth buckets) offset) buckets))
        (composedRateState aggregate (debitRateBucket (add (rateBucketWidth buckets) offset) buckets))
