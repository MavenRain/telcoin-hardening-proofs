    | off => same
    | on => same

def rateNonemptyCountsOne : (remaining : Count) -> Equal Count (rateNonempty (next remaining)) (next zero) :=
  fun (remaining : Count) => same

def rec rateBucketWidth : RateBuckets -> Count :=
  fun (buckets : RateBuckets) =>
    case buckets as table in RateBuckets return Count with
    | rateBucketsEnd => zero
    | rateBucket credits rest => next (rateBucketWidth rest)

def rec appendRateBuckets : RateBuckets -> RateBuckets -> RateBuckets :=
  fun (prefix : RateBuckets) (suffix : RateBuckets) =>
    case prefix as table in RateBuckets return RateBuckets with
    | rateBucketsEnd => suffix
    | rateBucket credits rest => rateBucket credits (appendRateBuckets rest suffix)

def rec rateBoundaryCreditZero : (prefix : RateBuckets) -> (suffix : RateBuckets) -> Equal Count
    (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))) zero :=
  fun (prefix : RateBuckets) (suffix : RateBuckets) =>
    case prefix as table in RateBuckets return Equal Count
        (rateBucketCredit (rateBucketWidth table) (appendRateBuckets table (rateBucket zero suffix))) zero with
    | rateBucketsEnd => same
    | rateBucket credits rest => rateBoundaryCreditZero rest suffix

def rec rateBoundaryZeroDebitNoOp : (prefix : RateBuckets) -> (suffix : RateBuckets) -> Equal RateBuckets
    (debitRateBucket (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix)))
    (appendRateBuckets prefix (rateBucket zero suffix)) :=
  fun (prefix : RateBuckets) (suffix : RateBuckets) =>
    case prefix as table in RateBuckets return Equal RateBuckets
        (debitRateBucket (rateBucketWidth table) (appendRateBuckets table (rateBucket zero suffix)))
        (appendRateBuckets table (rateBucket zero suffix)) with
    | rateBucketsEnd => same
    | rateBucket credits rest => congruent RateBuckets RateBuckets (fun (after : RateBuckets) => rateBucket credits after)
        (debitRateBucket (rateBucketWidth rest) (appendRateBuckets rest (rateBucket zero suffix)))
        (appendRateBuckets rest (rateBucket zero suffix)) (rateBoundaryZeroDebitNoOp rest suffix)

def rateZeroBoundaryAttemptStable : (enabled : Flag) -> (aggregate : Count) -> (prefix : RateBuckets) -> (suffix : RateBuckets) ->
    Equal ComposedRateState (composedRateState
      (rateAggregateSpend enabled aggregate
        (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
      (rateSourceSpend enabled (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
      (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix))) :=
  fun (enabled : Flag) (aggregate : Count) (prefix : RateBuckets) (suffix : RateBuckets) =>
    case enabled as allowed in Flag return Equal ComposedRateState (composedRateState
        (rateAggregateSpend allowed aggregate
          (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
        (rateSourceSpend allowed (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
        (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix))) with
    | off => same
    | on => equalTransitivity ComposedRateState
        (composedRateState (rateAggregateSpend on aggregate
          (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
          (debitRateBucket (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
        (composedRateState aggregate (debitRateBucket (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
        (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix)))
        (congruent Count ComposedRateState (fun (credits : Count) => composedRateState
          (rateAggregateSpend on aggregate credits)
          (debitRateBucket (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
          (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))) zero
          (rateBoundaryCreditZero prefix suffix))
        (congruent RateBuckets ComposedRateState (fun (after : RateBuckets) => composedRateState aggregate after)
          (debitRateBucket (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix)))
          (appendRateBuckets prefix (rateBucket zero suffix)) (rateBoundaryZeroDebitNoOp prefix suffix))

def composedZeroSourceBoundaryNoOp : (reachability : Reachability) -> (address : SourceAddress) ->
    (swarm : SwarmClass) -> (trusted : Flag) -> (identity : Count) -> (claimedKey : Count) -> (eligible : Flag) ->
    (aggregateBurst : Count) -> (aggregateRate : Count) -> (sourceBurst : Count) -> (sourceRate : Count) ->
    (aggregate : Count) -> (prefix : RateBuckets) -> (suffix : RateBuckets) ->
    Equal Count (normalizedSourceKey address) (rateBucketWidth prefix) -> Equal ComposedRateState
      (composedRateStep aggregateBurst aggregateRate sourceBurst sourceRate
        (composedRateAttempt reachability address swarm trusted identity claimedKey eligible)
        (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix))))
      (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix))) :=
  fun (reachability : Reachability) (address : SourceAddress) (swarm : SwarmClass) (trusted : Flag)
      (identity : Count) (claimedKey : Count) (eligible : Flag) (aggregateBurst : Count) (aggregateRate : Count)
      (sourceBurst : Count) (sourceRate : Count) (aggregate : Count) (prefix : RateBuckets) (suffix : RateBuckets)
      (selected : Equal Count (normalizedSourceKey address) (rateBucketWidth prefix)) =>
    equalTransitivity ComposedRateState
      (composedRateStep aggregateBurst aggregateRate sourceBurst sourceRate
        (composedRateAttempt reachability address swarm trusted identity claimedKey eligible)
        (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix))))
      (composedRateState
        (rateAggregateSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) aggregate
          (rateBucketCredit (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
        (rateSourceSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate)
          (rateBucketWidth prefix) (appendRateBuckets prefix (rateBucket zero suffix))))
      (composedRateState aggregate (appendRateBuckets prefix (rateBucket zero suffix)))
      (congruent Count ComposedRateState (fun (key : Count) => composedRateState
        (rateAggregateSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) aggregate
          (rateBucketCredit key (appendRateBuckets prefix (rateBucket zero suffix))))
        (rateSourceSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) key
          (appendRateBuckets prefix (rateBucket zero suffix))))
        (normalizedSourceKey address) (rateBucketWidth prefix) selected)
      (rateZeroBoundaryAttemptStable (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate)
        aggregate prefix suffix)

