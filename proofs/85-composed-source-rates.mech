          (debitRateBucket (add (rateBucketWidth buckets) offset) buckets))
          (rateBucketCredit (add (rateBucketWidth buckets) offset) buckets) zero (rateBeyondAllocationCreditZero buckets offset))
        (congruent RateBuckets ComposedRateState (fun (after : RateBuckets) => composedRateState aggregate after)
          (debitRateBucket (add (rateBucketWidth buckets) offset) buckets) buckets (rateBeyondAllocationDebitNoOp buckets offset))

def composedBeyondAllocationNoOp : (reachability : Reachability) -> (address : SourceAddress) ->
    (swarm : SwarmClass) -> (trusted : Flag) -> (identity : Count) -> (claimedKey : Count) -> (eligible : Flag) ->
    (aggregateBurst : Count) -> (aggregateRate : Count) -> (sourceBurst : Count) -> (sourceRate : Count) ->
    (aggregate : Count) -> (buckets : RateBuckets) -> (offset : Count) ->
    Equal Count (normalizedSourceKey address) (add (rateBucketWidth buckets) offset) -> Equal ComposedRateState
      (composedRateStep aggregateBurst aggregateRate sourceBurst sourceRate
        (composedRateAttempt reachability address swarm trusted identity claimedKey eligible) (composedRateState aggregate buckets))
      (composedRateState aggregate buckets) :=
  fun (reachability : Reachability) (address : SourceAddress) (swarm : SwarmClass) (trusted : Flag)
      (identity : Count) (claimedKey : Count) (eligible : Flag) (aggregateBurst : Count) (aggregateRate : Count)
      (sourceBurst : Count) (sourceRate : Count) (aggregate : Count) (buckets : RateBuckets) (offset : Count)
      (selected : Equal Count (normalizedSourceKey address) (add (rateBucketWidth buckets) offset)) =>
    equalTransitivity ComposedRateState
      (composedRateStep aggregateBurst aggregateRate sourceBurst sourceRate
        (composedRateAttempt reachability address swarm trusted identity claimedKey eligible) (composedRateState aggregate buckets))
      (composedRateState (rateAggregateSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) aggregate
        (rateBucketCredit (add (rateBucketWidth buckets) offset) buckets))
        (rateSourceSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate)
          (add (rateBucketWidth buckets) offset) buckets))
      (composedRateState aggregate buckets)
      (congruent Count ComposedRateState (fun (key : Count) => composedRateState
        (rateAggregateSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) aggregate
          (rateBucketCredit key buckets))
        (rateSourceSpend (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate) key buckets))
        (normalizedSourceKey address) (add (rateBucketWidth buckets) offset) selected)
      (rateBeyondAllocationAttemptStable (rateAggregateGate (rateValidatedEligibility reachability eligible) aggregate)
        aggregate buckets offset)
